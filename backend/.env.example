PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL connection (use the password you chose while installing PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=doctor_appointment
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Any long random text. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_text

# The admin account is created automatically on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123

# Time zone used inside notification messages
APP_TIMEZONE=Asia/Kolkata
